---
layout: base.njk
title: Blog
description: Notes from Chieflabz on products, systems, and ideas shaping digital work and finance.
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Chieflabz Blog",
  "url": "{{ site.url }}/blog/",
  "description": {{ description | dump | safe }},
  "publisher": {
    "@type": "Organization",
    "name": {{ site.title | dump | safe }},
    "url": "{{ site.url }}"
  }
}
</script>

<h1>Blog</h1>
<p>{{ description }}</p>

<ul class="post-list">
{% for post in collections.posts | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <p>{{ post.data.description }}</p>
    <time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | date }}</time>
  </li>
{% endfor %}
</ul>
