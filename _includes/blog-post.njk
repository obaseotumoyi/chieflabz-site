---
layout: base.njk
ogType: article
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (summary or description) | dump | safe }},
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ (updated or date) | isoDate }}",
  "author": {
    "@type": "Organization",
    "name": {{ (author or site.author) | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.title | dump | safe }},
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}{{ site.ogImage }}"
    }
  },
  {% if ogImage %}"image": "{{ site.url }}{{ ogImage }}",{% endif %}
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.url }}/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
  ]
}
</script>

<article>
  <p class="breadcrumbs"><a href="/">Home</a> / <a href="/blog/">Blog</a></p>

  <h1>{{ title }}</h1>

  <p class="byline">
    By {{ author or site.author }} ·
    <time datetime="{{ date | isoDate }}">{{ date | date }}</time>
    {% if updated %}(updated <time datetime="{{ updated | isoDate }}">{{ updated | date }}</time>){% endif %}
  </p>

  {{ content | safe }}
</article>
