<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }} | {{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description or site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.ogImage }}" />

  <link rel="stylesheet" href="/src/css/tokens.css">
  <link rel="stylesheet" href="/src/css/base.css">
  <link rel="stylesheet" href="/src/css/layout.css">
  <link rel="stylesheet" href="/src/css/panels.css">
</head>

<body>

  <!-- MOBILE HEADER (ONE ONLY) -->
  <header class="mobile-header">
    <a href="/" class="mobile-brand">
      <img src="/public/logo.png" alt="Chieflabz logo" />
      <span>Chieflabz</span>
    </a>
    <button class="menu-toggle" aria-label="Open menu">☰</button>
  </header>

  <div class="layout">

    <!-- LEFT PANEL -->
    <aside class="left-panel">
      <a href="/" class="brand">
        <img src="/public/logo.png" alt="Chieflabz logo" />
        <span>Chieflabz</span>
      </a>

      <nav class="nav">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
      </nav>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">
      <div class="container">
        {{ content | safe }}
      </div>

      <section class="mobile-resources">
        <h3>Resources</h3>

        <details>
        <summary>Security</summary>
        <a href="/resources/telegram-gifts-blacklist.html">
          Telegram Gifts Blacklist
        </a>
        </details>
      </section>
    </main>

    <!-- RIGHT PANEL -->
    <aside class="right-panel">
      <div class="panel-title">Resources</div>

      <details>
      <summary>Security</summary>
      <div class="details-links">
        <a href="/resources/telegram-gifts-blacklist.html">
          Telegram Gifts Blacklist
        </a>
      </div>
      </details>

    </aside>

  </div>

  <!-- SCRIPT AT BOTTOM -->
  <script src="/src/js/mobile-nav.js"></script>
</body>
</html>
